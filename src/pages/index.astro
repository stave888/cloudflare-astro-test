---
const apiUrl =
  "https://cloudflare-api-test.dac92102.workers.dev/api/hello";
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Pages + Worker API Test</title>
  </head>

  <body>
    <main>
      <h1>Cloudflare Pages + Worker</h1>

      <button id="load-api">调用 Worker API</button>

      <pre id="result">点击按钮调用 API...</pre>
    </main>

    <script>
      const button = document.querySelector("#load-api");
      const result = document.querySelector("#result");

      button?.addEventListener("click", async () => {
        result.textContent = "请求中...";

        try {
          const response = await fetch(
            "https://cloudflare-api-test.dac92102.workers.dev/api/hello"
          );

          const data = await response.json();

          result.textContent = JSON.stringify(data, null, 2);
        } catch (error) {
          result.textContent = `请求失败: ${error}`;
        }
      });
    </script>
  </body>
</html>